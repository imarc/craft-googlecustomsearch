{% extends "_layouts/cp" %}
{% set title = plugin.name %}
{% set docTitle = title ~ ' - ' ~ "Plugins"|t('app') %}
{% set readOnly = readOnly ?? false %}
{% set fullPageForm = not readOnly %}

{% set crumbs = [
    { label: "Settings"|t('app'), url: url('settings') },
    { label: "Plugins"|t('app'), url: url('settings/plugins') }
] %}

{% set continueEditingUrl = "settings/plugins/#{plugin.handle}" %}
{% if selectedSite is defined and craft.app.sites.getAllSites()|length > 1 %}
    {% set continueEditingUrl = continueEditingUrl ~ "?site=#{selectedSite.handle}" %}
{% endif %}

{% set formActions = [
    {
        label: 'Save and continue editing'|t('app'),
        redirect: continueEditingUrl|hash,
        shortcut: true,
        retainScroll: true,
    },
] %}

{% block content %}
    {% if not readOnly %}
        {{ actionInput('plugins/save-plugin-settings') }}
        {{ hiddenInput('pluginHandle', plugin.handle) }}
        {{ redirectInput('settings') }}
    {% endif %}
    {{ settingsHtml|raw }}
{% endblock %}
